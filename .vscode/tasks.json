{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PacketScope Console",
      "type": "process",
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": ["/d", "/c", "build.cmd", "console"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build PacketScope GUI",
      "type": "process",
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/d",
        "/c",
        "build.cmd",
        "gui",
        "/W4",
        "/std:c17",
        "/experimental:c11atomics"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
